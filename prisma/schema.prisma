
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id_admin           String               @id @db.VarChar(20)
  karyawan_produksi  karyawan_produksi[]
  laporan            laporan[]
  owner              owner[]
  pesanan_bahan_baku pesanan_bahan_baku[]
  pesanan_produk     pesanan_produk[]
  produk             produk[]
  resep_standar      resep_standar[]
  supplier           supplier[]
}

model bahan_baku {
  id_bahan_baku             String                      @id @db.VarChar(20)
  nama_bahan                String?                     @db.VarChar(100)
  stok_tersedia             Decimal?                    @db.Decimal(12, 2)
  stok_minimal              Decimal?                    @db.Decimal(12, 2)
  harga_satuan              Decimal?                    @db.Decimal(15, 2)
  id_owner                  String?                     @db.VarChar(20)
  id_laporan                String?                     @db.VarChar(20)
  id_supplier               String?                     @db.VarChar(20)
  id_karyawan               String?                     @db.VarChar(20)
  id_pengadaan              String?                     @db.VarChar(20)
  id_produk                 String?                     @db.VarChar(20)

  karyawan_produksi         karyawan_produksi?          @relation(fields: [id_karyawan], references: [id_karyawan], onDelete: NoAction, onUpdate: NoAction, map: "fk_bahan_karyawan")
  laporan                   laporan?                    @relation(fields: [id_laporan], references: [id_laporan], onDelete: NoAction, onUpdate: NoAction, map: "fk_bahan_laporan")
  owner                     owner?                      @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_bahan_owner")
  produk                    produk?                     @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction, map: "fk_bahan_produk")
  supplier                  supplier?                   @relation(fields: [id_supplier], references: [id_supplier], onDelete: NoAction, onUpdate: NoAction, map: "fk_bahan_supplier")
  detail_pesanan_bahan_baku detail_pesanan_bahan_baku[]
  resep_bahan_baku          resep_bahan_baku[]
  resep_standar             resep_standar[]

  @@index([id_owner], map: "idx_bahan_owner")
}

model karyawan_produksi {
  id_karyawan               String                      @id @db.VarChar(20)
  id_admin                  String?                     @db.VarChar(20)

  bahan_baku                bahan_baku[]
  admin                     admin?                      @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_karyawan_admin")
  penugasan_karyawan_produk penugasan_karyawan_produk[]
  produk                    produk[]
  resep_standar             resep_standar[]
}

model laporan {
  id_laporan       String           @id @db.VarChar(20)
  tanggal_generate DateTime?        @db.Date
  periode          String?          @db.VarChar(50)
  id_admin         String?          @db.VarChar(20)
  id_owner         String?          @db.VarChar(20)
  id_produk        String?          @db.VarChar(20)

  bahan_baku       bahan_baku[]
  admin            admin?           @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_laporan_admin")
  owner            owner?           @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_laporan_owner")
  produk           produk?          @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction, map: "fk_laporan_produk")
  pesanan_produk   pesanan_produk[]

  @@index([id_produk], map: "idx_laporan_produk")
}

model owner {
  id_owner           String               @id @db.VarChar(20)
  id_admin           String?              @db.VarChar(20)

  bahan_baku         bahan_baku[]
  laporan            laporan[]
  admin              admin?               @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_owner_admin")
  pesanan_bahan_baku pesanan_bahan_baku[]
  pesanan_produk     pesanan_produk[]
  produk             produk[]
  resep_standar      resep_standar[]
  supplier           supplier[]
}

model pesanan_bahan_baku {
  id_pengadaan              String                      @id @db.VarChar(20)
  status                    String                      @db.VarChar(30)
  tanggal_pesanan           DateTime                    @db.Date
  total_biaya               Decimal                     @default(0) @db.Decimal(15, 2)
  persetujuan_owner         String?                     @db.VarChar(20)
  jumlah_pesanan            Int                         @default(0)
  id_owner                  String?                     @db.VarChar(20)
  id_admin                  String?                     @db.VarChar(20)
  id_supplier               String                      @db.VarChar(20)

  detail_pesanan_bahan_baku detail_pesanan_bahan_baku[]
  admin                     admin?                      @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction)
  owner                     owner?                      @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_pbb_owner")
  supplier                  supplier                    @relation(fields: [id_supplier], references: [id_supplier], onDelete: NoAction, onUpdate: NoAction, map: "fk_pbb_supplier")
}

model pesanan_produk {
  id_pesanan            String                  @id @db.VarChar(20)
  tanggal_pesanan       DateTime?               @db.Date
  jenis_pesanan         String?                 @db.VarChar(30)
  status                String?                 @db.VarChar(30)
  nama_pelanggan        String?                 @db.VarChar(100)
  total_biaya_pesanan   Decimal?                @db.Decimal(15, 2)
  id_admin              String?                 @db.VarChar(20)
  id_laporan            String?                 @db.VarChar(20)
  id_owner              String?                 @db.VarChar(20)

  detail_pesanan_produk detail_pesanan_produk[]
  admin                 admin?                  @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_pesanan_admin")
  laporan               laporan?                @relation(fields: [id_laporan], references: [id_laporan], onDelete: NoAction, onUpdate: NoAction, map: "fk_pesanan_laporan")
  owner                 owner?                  @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_pesanan_owner")
  produk                produk[]

  @@index([id_owner], map: "idx_pesanan_produk_owner")
}

model produk {
  id_produk                 String                      @id @db.VarChar(20)
  jumlah_target             Int?
  jumlah_berhasil           Int?
  nama_produk               String?                     @db.VarChar(100)
  gambar_url                String?                     @db.VarChar(255)
  harga_jual                Decimal?                    @db.Decimal(15, 2)
  id_admin                  String?                     @db.VarChar(20)
  id_owner                  String?                     @db.VarChar(20)
  id_pesanan                String?                     @db.VarChar(20)
  id_karyawan               String?                     @db.VarChar(20)

  bahan_baku                bahan_baku[]
  detail_pesanan_produk     detail_pesanan_produk[]
  laporan                   laporan[]
  penugasan_karyawan_produk penugasan_karyawan_produk[]
  admin                     admin?                      @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_produk_admin")
  karyawan_produksi         karyawan_produksi?          @relation(fields: [id_karyawan], references: [id_karyawan], onDelete: NoAction, onUpdate: NoAction, map: "fk_produk_karyawan")
  owner                     owner?                      @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_produk_owner")
  pesanan_produk            pesanan_produk?             @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: NoAction, onUpdate: NoAction, map: "fk_produk_pesanan")
  resep_standar             resep_standar[]
  hasil_produksi            hasil_produksi[]

  @@index([id_owner], map: "idx_produk_owner")
}

model resep_standar {
  id_resep           String             @id @db.VarChar(20)
  nama_resep         String?            @db.VarChar(100)
  porsi_standar      Int?
  petunjuk_pembuatan String?
  id_admin           String?            @db.VarChar(20)
  id_owner           String?            @db.VarChar(20)
  id_karyawan        String?            @db.VarChar(20)
  id_bahan_baku      String?            @db.VarChar(20)
  id_produk          String?            @db.VarChar(20)

  resep_bahan_baku   resep_bahan_baku[]
  admin              admin?             @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_resep_admin")
  bahan_baku         bahan_baku?        @relation(fields: [id_bahan_baku], references: [id_bahan_baku], onDelete: NoAction, onUpdate: NoAction, map: "fk_resep_bahan")
  karyawan_produksi  karyawan_produksi? @relation(fields: [id_karyawan], references: [id_karyawan], onDelete: NoAction, onUpdate: NoAction, map: "fk_resep_karyawan")
  owner              owner?             @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_resep_owner")
  produk             produk?            @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction, map: "fk_resep_produk")
}

model supplier {
  id_supplier        String               @id @db.VarChar(20)
  nama_supplier      String?              @db.VarChar(100)
  username           String?              @db.VarChar(50)
  password           String?              @db.VarChar(255)
  email              String?              @db.VarChar(100)
  alamat             String?              @db.VarChar(255)
  id_admin           String?              @db.VarChar(20)
  id_owner           String?              @db.VarChar(20)

  bahan_baku         bahan_baku[]
  pesanan_bahan_baku pesanan_bahan_baku[]
  admin              admin?               @relation(fields: [id_admin], references: [id_admin], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplier_admin")
  owner              owner?               @relation(fields: [id_owner], references: [id_owner], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplier_owner")

  @@index([id_admin], map: "idx_supplier_admin")
  @@index([id_owner], map: "idx_supplier_owner")
}

model detail_pesanan_bahan_baku {
  id_pengadaan       String             @db.VarChar(20)
  id_bahan_baku      String             @db.VarChar(20)
  jumlah             Decimal            @db.Decimal(12, 2)
  harga_satuan       Decimal            @db.Decimal(12, 2)

  bahan_baku         bahan_baku         @relation(fields: [id_bahan_baku], references: [id_bahan_baku], onDelete: NoAction, onUpdate: NoAction)
  pesanan_bahan_baku pesanan_bahan_baku @relation(fields: [id_pengadaan], references: [id_pengadaan], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_pengadaan, id_bahan_baku])
}

model detail_pesanan_produk {
  id_pesanan     String         @db.VarChar(20)
  id_produk      String         @db.VarChar(20)
  jumlah         Int
  harga_satuan   Decimal        @db.Decimal(15, 2)

  pesanan_produk pesanan_produk @relation(fields: [id_pesanan], references: [id_pesanan], onDelete: Cascade, onUpdate: NoAction)
  produk         produk         @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_pesanan, id_produk])
}

model penugasan_karyawan_produk {
  id_karyawan       String            @db.VarChar(20)
  id_produk         String            @db.VarChar(20)

  karyawan_produksi karyawan_produksi @relation(fields: [id_karyawan], references: [id_karyawan], onDelete: NoAction, onUpdate: NoAction)
  produk            produk            @relation(fields: [id_produk], references: [id_produk], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_karyawan, id_produk])
}

model resep_bahan_baku {
  id_resep      String        @db.VarChar(20)
  id_bahan_baku String        @db.VarChar(20)
  jumlah_bahan  Decimal       @db.Decimal(12, 2)
  satuan        String?       @db.VarChar(30)

  bahan_baku    bahan_baku    @relation(fields: [id_bahan_baku], references: [id_bahan_baku], onDelete: NoAction, onUpdate: NoAction)
  resep_standar resep_standar @relation(fields: [id_resep], references: [id_resep], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_resep, id_bahan_baku])
}

model akun_pengguna {
  id             String    @id @db.VarChar(30)
  nama           String    @db.VarChar(100)
  email          String    @unique @db.VarChar(150)
  password_hash  String    @db.VarChar(255)
  role           String    @db.VarChar(30)
  ref_id         String?   @db.VarChar(20)
  avatar_url     String?   @db.VarChar(500)
  phone          String?   @db.VarChar(30)
  alamat         String?   @db.VarChar(500)
  aktif          Boolean   @default(true)
  akses_terakhir DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model hasil_produksi {
  id              String   @id @db.VarChar(30)
  id_produk       String   @db.VarChar(20)
  tanggal         DateTime @db.Date
  jumlah_target   Int
  jumlah_berhasil Int
  jumlah_ditolak  Int      @default(0)
  catatan_mutu    String?
  id_karyawan     String?  @db.VarChar(20)
  created_at      DateTime @default(now())

  produk          produk   @relation(fields: [id_produk], references: [id_produk], onDelete: Restrict)

  @@index([tanggal])
  @@index([id_produk])
}

model kapasitas_harian {
  tanggal            DateTime @id @db.Date
  kapasitas_total    Int      @default(800)
  kapasitas_terpakai Int      @default(0)
  jam_operasional    String?  @db.VarChar(50)
  updated_at         DateTime @updatedAt
}
